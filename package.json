{
  "name": "media_cataloger_web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "server:dev": "tsx watch server/main.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "test": "tsx --test server/**/__tests__/*.test.ts src/**/__tests__/*.test.ts",
    "test:server": "tsx --test server/**/__tests__/*.test.ts",
    "test:client": "tsx --test src/**/__tests__/*.test.ts",
    "start": "node dist-server/main.js"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.0.4",
    "@types/adm-zip": "^0.5.8",
    "@types/cron": "^2.0.1",
    "@xyflow/react": "^12.11.5",
    "adm-zip": "^0.6.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "comlink": "^4.4.2",
    "cron": "^4.4.0",
    "dotenv": "^16.4.7",
    "elkjs": "^0.12.0",
    "exiftool-vendored": "^38.0.0",
    "heic-convert": "^2.1.0",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.2.0"
